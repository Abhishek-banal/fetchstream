# ==============================================================================
# FetchStream Remote Runner - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the container:
#   cp .env.example .env
#
# All variables are optional with secure and sensible defaults.
# ==============================================================================

# Port the runner server binds to on the host machine (Default: 8000)
PORT=8000

# Optional API Key / Bearer Token to protect your runner from unauthorized access.
# If set, clients (including the Chrome extension) must supply this token in
# FetchStream Settings -> Server Upload -> "Server API Key / Token".
# If left empty, anyone who has network access to this port can dispatch jobs.
API_KEY=

# Optional Telegram API credentials (from https://my.telegram.org/apps)
# Only required if you plan to use direct 2GB MTProto uploads to Telegram channels/chats.
TG_API_ID=
TG_API_HASH=
